# =============================================================================
# VERDICT — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. NEVER share the SERVICE_ROLE key in plaintext.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Socket.io server (Railway) ----------------------------------------------
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
SOCKET_PORT=4000

# --- Redis (Upstash) ---------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Push notifications (OneSignal) ------------------------------------------
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Analytics (PostHog) -----------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Errors (Sentry) ---------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- AI scenario generation --------------------------------------------------
ANTHROPIC_API_KEY=
NEWSAPI_KEY=
OPENAI_MODERATION_API_KEY=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
FOUNDER_EMAIL=

# --- Cron security -----------------------------------------------------------
# Random secret used to authenticate Vercel cron requests
CRON_SECRET=

# --- App config --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_REGION=IN
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
